<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="wekbZj|Q_C;Bi!lJrs+Y">l</variable><variable id="jE?TtV}weT5X/]8$1jMK">code2</variable><variable id="g!!xM=)NP#Yjkr#7v:l`">bytes</variable><variable id="u?Ql]hICw~CcC?!,LH^3">buf</variable><variable id="rtus0s]v/%{*pcM+SBnZ">ADDRESS</variable></variables><block type="pxt-on-start" id="}MmE=i)J~$N[j_se9QBC" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="3rqx$d~,F[(0Dmh(zvC8"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="let code2 = 0" numlines="1" declaredvars="code2"></mutation><next><block type="typescript_statement" id="Lbenf-qBn:Qtj*z0;UDP"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="function decodeUTF16LE(buffer: Buffer): string {" line1="    let result = &quot;&quot;" line2="    for (let i = 0; i + 1 &lt; buffer.length; i += 2) {" line3="        let code = buffer.getUint8(i) | (buffer.getUint8(i + 1) &lt;&lt; 8)" line4="        if (code === 0) break" line5="        result += String.fromCharCode(code)" line6="    }" line7="    return result" line8="}" numlines="9"></mutation><next><block type="typescript_statement" id="#D6sbieI@5$u^6I@E$|_"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="function utf8Decode(buffer: Buffer): string {" line1="    let result2 = &quot;&quot;;" line2="    let j = 0;" line3="    while (j &lt; buffer.length) {" line4="        let byte1 = buffer.getUint8(j);" line5="        if (byte1 === 0) break; // 结束符" line6="" line7="        if (byte1 &lt; 0x80) {" line8="            // 1字节字符" line9="            result2 += String.fromCharCode(byte1);" line10="            j += 1;" line11="        } else if ((byte1 &amp; 0xe0) === 0xc0 &amp;&amp; j + 1 &lt; buffer.length) {" line12="            // 2字节字符" line13="            let byte2 = buffer.getUint8(j + 1);" line14="            let charCode = ((byte1 &amp; 0x1f) &lt;&lt; 6) | (byte2 &amp; 0x3f);" line15="            result2 += String.fromCharCode(charCode);" line16="            j += 2;" line17="        } else if ((byte1 &amp; 0xf0) === 0xe0 &amp;&amp; j + 2 &lt; buffer.length) {" line18="            // 3字节字符" line19="            let byte22 = buffer.getUint8(j + 1);" line20="            let byte3 = buffer.getUint8(j + 2);" line21="            let charCode2 = ((byte1 &amp; 0x0f) &lt;&lt; 12) |" line22="                ((byte22 &amp; 0x3f) &lt;&lt; 6) |" line23="                (byte3 &amp; 0x3f);" line24="            result2 += String.fromCharCode(charCode2);" line25="            j += 3;" line26="        } else {" line27="            // 其他情况略过（不完整或超过范围）" line28="            j += 1;" line29="        }" line30="    }" line31="    return result2;" line32="}" numlines="33"></mutation><next><block type="variables_set" id="g4SuTx*TH}3ga+oc,ZE["><field name="VAR" id="rtus0s]v/%{*pcM+SBnZ">ADDRESS</field><value name="VALUE"><shadow type="math_number" id="~Yaf1Ueq[O7t=l9+uBv:"><field name="NUM">36</field></shadow></value><next><block type="typescript_statement" id="U1)#CmmMNLe3kx2t{!kP"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum enColor {" line1="    R = 0," line2="    G = 1," line3="    B = 2" line4="}" numlines="5"></mutation><next><block type="typescript_statement" id="v@d~Y6?FAYM#@@8YR/T@"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum enAiType {" line1="    //% block=&quot;颜色识别&quot;" line2="    type1 = 0," line3="    //% block=&quot;色块追踪&quot;" line4="    type2 = 1," line5="    //% block=&quot;标签识别&quot;" line6="    type3 = 2," line7="    //% block=&quot;线条识别&quot;" line8="    type4 = 3," line9="    //% block=&quot;20类物体&quot;" line10="    type5 = 4," line11="    //% block=&quot;二维码识别&quot;" line12="    type6 = 5," line13="    //% block=&quot;人脸属性&quot;" line14="    type7 = 6," line15="    //% block=&quot;人脸识别&quot;" line16="    type8 = 7," line17="    //% block=&quot;深度学习&quot;" line18="    type9 = 8," line19="    //% block=&quot;卡片识别&quot;" line20="    type10 = 9" line21="}" numlines="22"></mutation><next><block type="typescript_statement" id="pMuP*$dt|[vKm]M~?KS@"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum enFindColor {" line1="    //% block=&quot;红&quot;" line2="    type1 = 1," line3="    //% block=&quot;绿&quot;" line4="    type2 = 2," line5="    //% block=&quot;蓝&quot;" line6="    type3 = 3," line7="    //% block=&quot;黄&quot;" line8="    type4 = 4," line9="    //% block=&quot;黑&quot;" line10="    type5 = 5," line11="    //% block=&quot;白&quot;" line12="    type6 = 6" line13="}" numlines="14"></mutation><next><block type="typescript_statement" id="8E8-Ggoo|!$V=J8;$8(|"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum enFindColorPos {" line1="    X=0," line2="    Y=1," line3="    W=2," line4="    H=3" line5="}" numlines="6"></mutation><next><block type="typescript_statement" id="]7y.1`B`9s7B7SJ;Kul|"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum enFind20Class {" line1="    //% block=&quot;(0)飞机&quot;" line2="    type0 = 0," line3="    //% block=&quot;(1)自行车&quot;" line4="    type1 = 1," line5="    //% block=&quot;(2)鸟&quot;" line6="    type2 = 2," line7="    //% block=&quot;(3)船&quot;" line8="    type3 = 3," line9="    //% block=&quot;(4)瓶&quot;" line10="    type4 = 4," line11="    //% block=&quot;(5)公交车&quot;" line12="    type5 = 5," line13="    //% block=&quot;(6)车&quot;" line14="    type6 = 6," line15="    //% block=&quot;(7)猫&quot;" line16="    type7 = 7," line17="    //% block=&quot;(8)椅子&quot;" line18="    type8 = 8," line19="    //% block=&quot;(9)牛&quot;" line20="    type9 = 9," line21="    //% block=&quot;(10)餐桌&quot;" line22="    type10 = 10," line23="    //% block=&quot;(11)狗&quot;" line24="    type11 = 11," line25="    //% block=&quot;(12)房子&quot;" line26="    type12 = 12," line27="    //% block=&quot;(13)摩托车&quot;" line28="    type13 = 13," line29="    //% block=&quot;(14)人&quot;" line30="    type14 = 14," line31="    //% block=&quot;(15)盆栽&quot;" line32="    type15 = 15," line33="    //% block=&quot;(16)羊&quot;" line34="    type16 = 16," line35="    //% block=&quot;(17)沙发&quot;" line36="    type17 = 17," line37="    //% block=&quot;(18)船&quot;" line38="    type18 = 18," line39="    //% block=&quot;(19)电视机&quot;" line40="    type19 = 19," line41="}" numlines="42"></mutation><next><block type="typescript_statement" id="Y=7o#HDf@|LDO*K0K|zS"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum enFaceNum{" line1="    //% block=&quot;人脸0&quot;" line2="    type1 = 2," line3="    //% block=&quot;人脸1&quot;" line4="    type2 = 3," line5="    //% block=&quot;人脸2&quot;" line6="    type3 = 4," line7="    //% block=&quot;人脸3&quot;" line8="    type4 = 5," line9="}" numlines="10"></mutation><next><block type="typescript_statement" id="{=Jhyr6*ebQk)k.qx]38"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum enLearnClass {" line1="    //% block=&quot;类别0&quot;" line2="    type1 = 0," line3="    //% block=&quot;类别1&quot;" line4="    type2 = 1" line5="    /*" line6="    //% block=&quot;类别2&quot;" line7="    type3 = 2," line8="    //% block=&quot;类别3&quot;" line9="    type4 = 3*/" line10="    " line11="}" numlines="12"></mutation><next><block type="typescript_statement" id="*O6jVGAfE-/-4;+6$EG!"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum enCardClass{" line1="    //% block=&quot;右转&quot;" line2="    type0 = 4," line3="    //% block=&quot;左转&quot;" line4="    type1 = 1," line5="    //% block=&quot;停车&quot;" line6="    type2 = 2," line7="    //% block=&quot;鸣笛&quot;" line8="    type3 = 5," line9="    //% block=&quot;绿灯&quot;" line10="    type4 = 0," line11="    //% block=&quot;红灯&quot;" line12="    type5 = 3," line13="    //% block=&quot;标靶&quot;" line14="    type6 = 6" line15="}" numlines="16"></mutation><next><block type="typescript_statement" id="FWy#deAV!yTJV*O]UHT8"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum enPosition{" line1="    //% block=&quot;上&quot;" line2="    type1 = 3," line3="    //% block=&quot;中&quot;" line4="    type2 = 2," line5="    //% block=&quot;下&quot;" line6="    type3 = 1," line7="}" numlines="8"></mutation><next><block type="typescript_statement" id="v-,FY8@WwV4JfRXi`y-Q"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum enFindFaceStats{" line1="    // //% block=&quot;男性&quot;" line2="    // type1 = 0," line3="    //% block=&quot;张开嘴&quot;" line4="    type2 = 1," line5="    //% block=&quot;微笑&quot;" line6="    type3 = 2," line7="    //% block=&quot;戴眼镜&quot;" line8="    type4 = 3," line9="}" numlines="10"></mutation><next><block type="typescript_statement" id="wXbf.ENP_Bktl/7@]hi8"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace AI_Vision {" line1="    //% blockId=SetMode " line2="    //% block=&quot;视觉模块切换到 %choicetype &quot;" line3="    //%  weight=101" line4="    export function SetMode(choicetype: enAiType): void {" line5="        let buf2 = pins.createBuffer(2);" line6="        buf2[0] = 0" line7="        buf2[1] = choicetype" line8="        pins.i2cWriteBuffer(ADDRESS, buf2);" line9="    }" line10="" line11="    //% blockId=GetMode " line12="    //% block=&quot;当前模式&quot;" line13="    //%  weight=100" line14="    export function GetMode(): number {" line15="        sendOrder(0, 0)" line16="        let GetBuff = pins.createBuffer(1)" line17="        GetBuff = pins.i2cReadBuffer(ADDRESS, 1)" line18="        return GetBuff.getNumber(NumberFormat.UInt8BE, 0)" line19="        return 0" line20="    }" line21="" line22="    //--------------------------颜色识别----------------------" line23="    //% blockId=GetColor" line24="    //% block=&quot;识别到颜色的 %choiceColor 值&quot;" line25="    //% group=&quot;颜色识别&quot; weight=3" line26="    export function GetColor(choiceColor: enColor): number {" line27="        sendOrder(15, 0)" line28="        let GetBuff2 = pins.createBuffer(3)" line29="        GetBuff2 = pins.i2cReadBuffer(ADDRESS, 3)" line30="        return GetBuff2.getNumber(NumberFormat.UInt8BE, choiceColor)" line31="    }" line32="" line33="    //--------------------------色块追踪----------------------" line34="    //% blockId=SetFindColor" line35="    //% block=&quot;设置追踪颜色 %choicefindcolor &quot;" line36="    //% group=&quot;色块追踪&quot; weight=3" line37="    export function SetFindColor(choicefindcolor: enFindColor): void {" line38="        let buf3 = pins.createBuffer(2);" line39="        buf3[0] = 30 //39" line40="        buf3[1] = choicefindcolor" line41="        pins.i2cWriteBuffer(ADDRESS, buf3);" line42="    }" line43="" line44="    //% blockId=getFindColor" line45="    //% block=&quot;追踪到目标颜色?&quot;" line46="    //% group=&quot;色块追踪&quot; weight=2" line47="    export function getFindColor(): boolean {" line48="        sendOrder(30,1)" line49="        let GetBuff22 = pins.createBuffer(1)" line50="        GetBuff22 = pins.i2cReadBuffer(ADDRESS,1)" line51="     " line52="        if (GetBuff22.getNumber(NumberFormat.UInt8BE, 0) == 0){" line53="            return false;" line54="        }else{" line55="            return true;" line56="        }  " line57="    }" line58="" line59="    //% blockId=getFindColorPos" line60="    //% block=&quot;获取色块位置信息 %choicefindcolorpos&quot;" line61="    //% group=&quot;色块追踪&quot; weight=1" line62="    export function getFindColorPos(choicefindcolorpos: enFindColorPos): number {" line63="        sendOrder(30, 2)" line64="" line65="        let GetBuff222 = pins.createBuffer(8)" line66="        GetBuff222 = pins.i2cReadBuffer(ADDRESS, 8);" line67="        let Hbuf = GetBuff222.getNumber(NumberFormat.UInt8BE, choicefindcolorpos * 2)" line68="        let Lbuf = GetBuff222.getNumber(NumberFormat.UInt8BE, choicefindcolorpos * 2 +1)" line69="        let combinedData = ((Hbuf &amp; 0xFF) &lt;&lt; 8) | (Lbuf &amp; 0xFF);" line70="        return combinedData" line71="    }" line72="" line73="" line74="    //--------------------------标签识别----------------------" line75="    //% blockId=getFindTagNum" line76="    //% block=&quot;识别到标签数量 &quot;" line77="    //% group=&quot;标签识别&quot; weight=4" line78="    export function getFindTagNum(): number {" line79="        sendOrder(45, 0)//63" line80="        let GetBuff3 = pins.createBuffer(1)" line81="        GetBuff3 = pins.i2cReadBuffer(ADDRESS, 1)" line82="        return GetBuff3.getNumber(NumberFormat.UInt8BE, 0)" line83="    }" line84="" line85="    //% blockId=getFindTagID" line86="    //% block=&quot;识别到标签内容 &quot;" line87="    //% group=&quot;标签识别&quot; weight=3" line88="    export function getFindTagID(): number {" line89="        sendOrder(45, 1)" line90="        let GetBuff4 = pins.createBuffer(12)" line91="        GetBuff4 = pins.i2cReadBuffer(ADDRESS, 12)" line92="        let Hbuf2 = GetBuff4.getNumber(NumberFormat.UInt8BE, 0)" line93="        let Lbuf2 = GetBuff4.getNumber(NumberFormat.UInt8BE, 1)" line94="        let combinedData2 = ((Hbuf2 &amp; 0xFF) &lt;&lt; 8) | (Lbuf2 &amp; 0xFF);" line95="        return combinedData2;//GetBuff4.getNumber(NumberFormat.UInt8BE, 0)" line96="    }" line97="" line98="    //% blockId=getFindTagRot" line99="    //% block=&quot;标签旋转角度&quot;" line100="    //% group=&quot;标签识别&quot; weight=2" line101="    export function getFindTagRot(): number {" line102="        sendOrder(45, 1)" line103="        let GetBuff5 = pins.createBuffer(12)" line104="        GetBuff5 = pins.i2cReadBuffer(ADDRESS, 63 + 1)" line105="        let Hbuf22 = GetBuff5.getNumber(NumberFormat.UInt8BE,  2)" line106="        let Lbuf22 = GetBuff5.getNumber(NumberFormat.UInt8BE,  3)" line107="        let combinedData22 = ((Hbuf22 &amp; 0xFF) &lt;&lt; 8) | (Lbuf22 &amp; 0xFF);" line108="        return combinedData22" line109="    }" line110="" line111="    //% blockId=getFindTagPos" line112="    //% block=&quot;识别到标签位置信息 %choicefindcolorpos&quot;" line113="    //% group=&quot;标签识别&quot; weight=1" line114="    export function getFindTagPos(choicefindcolorpos: enFindColorPos): number {" line115="        sendOrder(45, 1)" line116="        let GetBuff52 = pins.createBuffer(12)" line117="        GetBuff52 = pins.i2cReadBuffer(ADDRESS, 63 + 1)" line118="        let Hbuf23 = GetBuff52.getNumber(NumberFormat.UInt8BE, choicefindcolorpos * 2 + 4)" line119="        let Lbuf23 = GetBuff52.getNumber(NumberFormat.UInt8BE, choicefindcolorpos * 2 + 5)" line120="        let combinedData23 = ((Hbuf23 &amp; 0xFF) &lt;&lt; 8) | (Lbuf23 &amp; 0xFF);" line121="        return combinedData23" line122="    }" line123="" line124="" line125="    //--------------------------线条识别----------------------" line126="    //% blockId=getFindLine" line127="    //% block=&quot;是否识别到线？ &quot;" line128="    //% group=&quot;线条识别&quot; weight=3" line129="    export function getFindLine(): boolean {" line130="        sendOrder(60, 0)//87" line131="        let GetBuff6 = pins.createBuffer(1)" line132="        GetBuff6 = pins.i2cReadBuffer(ADDRESS, 1)" line133="        if (GetBuff6.getNumber(NumberFormat.UInt8BE, 0) == 0) {" line134="            return false;" line135="        } else {" line136="            return true;" line137="        }" line138="    }" line139="" line140="    //% blockId=getFindLinePos" line141="    //% block=&quot;获取位置为 %choiceposition 的线条位置信息 %choicefindcolorpos&quot;" line142="    //% group=&quot;线条识别&quot; weight=1" line143="    export function getFindLinePos(choiceposition: enPosition,choicefindcolorpos: enFindColorPos): number {" line144="        sendOrder(60, choiceposition)" line145="        let GetBuff7 = pins.createBuffer(8)" line146="        GetBuff7 = pins.i2cReadBuffer(ADDRESS, 8);" line147="        let Hbuf3 = GetBuff7.getNumber(NumberFormat.UInt8BE, choicefindcolorpos * 2)" line148="        let Lbuf3 = GetBuff7.getNumber(NumberFormat.UInt8BE, choicefindcolorpos * 2 + 1)" line149="        let combinedData3 = ((Hbuf3 &amp; 0xFF) &lt;&lt; 8) | (Lbuf3 &amp; 0xFF);" line150="        return combinedData3" line151="    }" line152="" line153="    //--------------------------20类物体识别----------------------" line154="    //% blockId=getFind20ClassNum" line155="    //% block=&quot;识别到物体数量&quot;" line156="    //% group=&quot;20类物体识别&quot; weight=3" line157="    export function getFind20ClassNum(): number {" line158="        sendOrder(75, 0)//111" line159="        let GetBuff8 = pins.createBuffer(1)" line160="        GetBuff8 = pins.i2cReadBuffer(ADDRESS, 1);" line161="        return GetBuff8.getNumber(NumberFormat.UInt8BE, 0)" line162="    }" line163="" line164="    //% blockId=getFind20ClassId" line165="    //% block=&quot;识别到物体 %choicefind20class ?&quot;" line166="    //% group=&quot;20类物体识别&quot; weight=2" line167="    export function getFind20ClassId( choicefind20class: enFind20Class): boolean {" line168="        sendOrder(75, 1)" line169="        let GetBuff9 = pins.createBuffer(9)" line170="        GetBuff9 = pins.i2cReadBuffer(ADDRESS, 9);" line171="        if (GetBuff9.getNumber(NumberFormat.UInt8BE, 0) == choicefind20class){" line172="            return true" line173="        }" line174="        return false" line175="    }" line176="" line177="    //% blockId=getFind20ClassPos" line178="    //% block=&quot;识别到物体位置信息 %choicefindcolorpos&quot;" line179="    //% group=&quot;20类物体识别&quot; weight=1" line180="    export function getFind20ClassPos(choicefindcolorpos: enFindColorPos): number {" line181="        sendOrder(75, 1)" line182="        let GetBuff10 = pins.createBuffer(9)" line183="        GetBuff10 = pins.i2cReadBuffer(ADDRESS, 9)" line184="        let Hbuf4 = GetBuff10.getNumber(NumberFormat.UInt8BE, choicefindcolorpos * 2 + 1)" line185="        let Lbuf4 = GetBuff10.getNumber(NumberFormat.UInt8BE, choicefindcolorpos * 2 + 2)" line186="        let combinedData4 = ((Hbuf4 &amp; 0xFF) &lt;&lt; 8) | (Lbuf4 &amp; 0xFF);" line187="        return combinedData4" line188="    }" line189="" line190="    //--------------------------二维码识别----------------------" line191="    //% blockId=getFindQr" line192="    //% block=&quot;是否识别到二维码？ &quot;" line193="    //% group=&quot;二维码识别&quot; weight=3" line194="    export function getFindQr(): boolean {" line195="        sendOrder(90, 0)//135" line196="        let GetBuff11 = pins.createBuffer(1)" line197="        GetBuff11 = pins.i2cReadBuffer(ADDRESS, 1);" line198="        if (GetBuff11.getNumber(NumberFormat.UInt8BE, 0) == 0){" line199="            return false" line200="        }" line201="        return true" line202="    }" line203="" line204="    //% blockId=getFindQrID" line205="    //% block=&quot;识别到二维码内容 &quot;" line206="    //% group=&quot;二维码识别&quot; weight=2" line207="    export function getFindQrID(): string {" line208="        sendOrder(90, 3)" line209="        let buffer = pins.i2cReadBuffer(ADDRESS, 50);" line210="" line211="        let str = &quot;&quot;;" line212="        for (let k = 0; k &lt; buffer.length; k++) {" line213="            const byte = buffer.getUint8(k);" line214="            serial.writeNumber(buffer.getUint8(k))" line215="            if (byte === 0) break;" line216="" line217="            str += String.fromCharCode(byte);" line218="        }" line219="" line220="        return str;" line221="    }" line222="" line223="" line224="    //% blockId=getFindQrPos" line225="    //% block=&quot;识别到二维码位置信息 %choicefindcolorpos&quot;" line226="    //% group=&quot;二维码识别&quot; weight=1" line227="    export function getFindQrPos(choicefindcolorpos: enFindColorPos): number {" line228="        sendOrder(90, 2)" line229="        let GetBuff13 = pins.createBuffer(8)" line230="        GetBuff13 = pins.i2cReadBuffer(ADDRESS, 8)" line231="        let Hbuf5 = GetBuff13.getNumber(NumberFormat.UInt8BE, choicefindcolorpos * 2 )" line232="        let Lbuf5 = GetBuff13.getNumber(NumberFormat.UInt8BE, choicefindcolorpos * 2 + 1)" line233="        let combinedData5 = ((Hbuf5 &amp; 0xFF) &lt;&lt; 8) | (Lbuf5 &amp; 0xFF);" line234="        return combinedData5" line235="    }" line236="" line237="" line238="    //--------------------------人脸属性----------------------" line239="    //% blockId=getFindFace" line240="    //% block=&quot;检测到人脸数量 &quot;" line241="    //% group=&quot;人脸属性&quot; weight=3" line242="    export function getFindFace(): number {" line243="        sendOrder(105, 0)//159" line244="        let GetBuff14 = pins.createBuffer(1)" line245="        GetBuff14 = pins.i2cReadBuffer(ADDRESS, 1);" line246="        return GetBuff14.getNumber(NumberFormat.UInt8BE, 0)" line247="    }" line248="" line249="    //% blockId=getFindFacePos" line250="    //% block=&quot;检测到 %choicefacenum 位置信息 %choicefindcolorpos&quot;" line251="    //% group=&quot;人脸属性&quot; weight=2" line252="    export function getFindFacePos(choicefacenum: enFaceNum, choicefindcolorpos: enFindColorPos): number {" line253="        sendOrder(105, choicefacenum-1)" line254="        let GetBuff15 = pins.createBuffer(8)" line255="        GetBuff15 = pins.i2cReadBuffer(ADDRESS, 8)" line256="        let Hbuf6 = GetBuff15.getNumber(NumberFormat.UInt8BE, choicefindcolorpos * 2)" line257="        let Lbuf6 = GetBuff15.getNumber(NumberFormat.UInt8BE, choicefindcolorpos * 2 + 1)" line258="        let combinedData6 = ((Hbuf6 &amp; 0xFF) &lt;&lt; 8) | (Lbuf6 &amp; 0xFF);" line259="        return combinedData6" line260="    }" line261="" line262="    //% blockId=getFindFaceStats" line263="    //% block=&quot;%choicefacenum 是否为 %choicefindfacestats&quot;" line264="    //% group=&quot;人脸属性&quot; weight=1" line265="    export function getFindFaceStats(choicefacenum: enFaceNum, choicefindfacestats: enFindFaceStats): boolean {" line266="        sendOrder(105, 3+choicefacenum)" line267="        let GetBuff16 = pins.createBuffer(4)" line268="        GetBuff16 = pins.i2cReadBuffer(ADDRESS, 4)" line269="        if (GetBuff16.getNumber(NumberFormat.UInt8BE, choicefindfacestats)==1){" line270="            return true" line271="        }" line272="        return false" line273="    }" line274="" line275="" line276="    //--------------------------人脸识别----------------------" line277="    //% blockId=setFaceRecognition" line278="    //% block=&quot;对当前人脸进行学习&quot;" line279="    //% group=&quot;人脸识别&quot; weight=4" line280="    export function setFaceRecognition(): void {" line281="        let buf4 = pins.createBuffer(2);" line282="        buf4[0] = 120 + 6" line283="        buf4[1] = 1" line284="        pins.i2cWriteBuffer(ADDRESS, buf4);" line285="    }" line286="" line287="    //% blockId=getFaceNum" line288="    //% block=&quot;识别到的人脸数量&quot;" line289="    //% group=&quot;人脸识别&quot; weight=3" line290="    export function getFaceNum(): number {" line291="        sendOrder(120, 0)//183" line292="        let GetBuff17 = pins.createBuffer(1)" line293="        GetBuff17 = pins.i2cReadBuffer(ADDRESS, 1);" line294="        return GetBuff17.getNumber(NumberFormat.UInt8BE, 0)" line295="    }" line296="" line297="    //% blockId=getFaceRecognition" line298="    //% block=&quot;识别到学习过的人脸数量&quot;" line299="    //% group=&quot;人脸识别&quot; weight=2" line300="    export function getFaceRecognition(): number {" line301="        sendOrder(120, 1)//183" line302="        let GetBuff162 = pins.createBuffer(1)" line303="        GetBuff162 = pins.i2cReadBuffer(ADDRESS, 1);" line304="        return GetBuff162.getNumber(NumberFormat.UInt8BE, 0)" line305="    }" line306="" line307="    //% blockId=getFaceRecognitionPos" line308="    //% block=&quot;识别到 %choicefacenum 位置信息 %choicefindcolorpos&quot;" line309="    //% group=&quot;人脸识别&quot; weight=1" line310="    export function getFaceRecognitionPos(choicefacenum: enFaceNum, choicefindcolorpos: enFindColorPos): number {" line311="        sendOrder(120, choicefacenum)" line312="        let GetBuff172 = pins.createBuffer(9)" line313="        GetBuff172 = pins.i2cReadBuffer(ADDRESS, 9)" line314="        let Hbuf7 = GetBuff172.getNumber(NumberFormat.UInt8BE, choicefindcolorpos * 2 + 1)" line315="        let Lbuf7 = GetBuff172.getNumber(NumberFormat.UInt8BE, choicefindcolorpos * 2 + 2)" line316="        let combinedData7 = ((Hbuf7 &amp; 0xFF) &lt;&lt; 8) | (Lbuf7 &amp; 0xFF);" line317="        return combinedData7" line318="    }" line319="" line320="    //--------------------------深度学习----------------------" line321="    /*" line322="    //% blockId=setLearning" line323="    //% block=&quot;对当前图像进行学习&quot;" line324="    //% group=&quot;深度学习&quot; weight=3" line325="    export function setLearning(): void {" line326="        let buf5 = pins.createBuffer(2);" line327="        buf5[0] = 135 //207" line328="        buf5[1] = 1" line329="        pins.i2cWriteBuffer(ADDRESS, buf5);" line330="    }" line331="    */" line332="    //% blockId=getLearnClass" line333="    //% block=&quot;是否识别到 %choiceLearnClass?&quot;" line334="    //% group=&quot;深度学习&quot; weight=2" line335="    export function getLearnClass(choiceLearnClass: enLearnClass): boolean {" line336="        sendOrder(135, 1)" line337="        let GetBuff18 = pins.createBuffer(1)" line338="        GetBuff18 = pins.i2cReadBuffer(ADDRESS, 1);" line339="        if (GetBuff18.getNumber(NumberFormat.UInt8BE, 0) == 1){" line340="            sendOrder(135, 2)" line341="            let GetBuff19 = pins.createBuffer(1)" line342="            GetBuff19 = pins.i2cReadBuffer(ADDRESS, 1);" line343="            if (GetBuff19.getNumber(NumberFormat.UInt8BE, 0) == choiceLearnClass){" line344="                return true" line345="            }" line346="        }" line347="        return false" line348="    }" line349="/*" line350="    //% blockId=getLearnClassValue" line351="    //% block=&quot;识别到 %choiceLearnClass 的可信度&quot;" line352="    //% group=&quot;深度学习&quot; weight=1" line353="    export function getLearnClassValue(choiceLearnClass: enLearnClass): number {" line354="        sendOrder(135, 3)" line355="        let GetBuff182 = pins.createBuffer(4)" line356="        GetBuff182 = pins.i2cReadBuffer(ADDRESS, 4);" line357="        return GetBuff182.getNumber(NumberFormat.UInt8BE, choiceLearnClass)" line358="    }*/" line359="" line360="    //--------------------------卡片识别----------------------" line361="    //% blockId=getCardNum" line362="    //% block=&quot;识别到卡片的数量&quot;" line363="    //% group=&quot;卡片识别&quot; weight=3" line364="    export function getCardNum(): number {" line365="        sendOrder(150, 0)//231" line366="        let GetBuff192 = pins.createBuffer(1)" line367="        GetBuff192 = pins.i2cReadBuffer(ADDRESS, 1);" line368="        return GetBuff192.getNumber(NumberFormat.UInt8BE, 0)" line369="    }" line370="" line371="    //% blockId=getCardClass" line372="    //% block=&quot;识别到卡片 %cardClass?&quot;" line373="    //% group=&quot;卡片识别&quot; weight=2" line374="    export function getCardClass(cardClass: enCardClass): boolean {" line375="        sendOrder(150, 0)" line376="        let GetBuff1922 = pins.createBuffer(1)" line377="        GetBuff1922 = pins.i2cReadBuffer(ADDRESS, 1)" line378="        if (GetBuff1922.getNumber(NumberFormat.UInt8BE, 0) &gt; 0){" line379="            sendOrder(150, 1)" line380="            let GetBuff193 = pins.createBuffer(9)" line381="            GetBuff193 = pins.i2cReadBuffer(ADDRESS, 9);" line382="            if (GetBuff193.getNumber(NumberFormat.UInt8BE, 0) == cardClass) {" line383="                return true" line384="            }" line385="        }" line386="        return false" line387="    }" line388="" line389="    //% blockId=getCardPos" line390="    //% block=&quot;识别到卡片位置信息 %choicefindcolorpos&quot;" line391="    //% group=&quot;卡片识别&quot; weight=1" line392="    export function getCardPos(choicefindcolorpos: enFindColorPos): number {" line393="        sendOrder(150, 1)" line394="        let GetBuff194 = pins.createBuffer(9)" line395="        GetBuff194 = pins.i2cReadBuffer(ADDRESS, 9);" line396="        let Hbuf72 = GetBuff194.getNumber(NumberFormat.UInt8BE, choicefindcolorpos * 2 + 1)" line397="        let Lbuf72 = GetBuff194.getNumber(NumberFormat.UInt8BE, choicefindcolorpos * 2 + 2)" line398="        let combinedData72 = ((Hbuf72 &amp; 0xFF) &lt;&lt; 8) | (Lbuf72 &amp; 0xFF);" line399="        return combinedData72" line400="    }" line401="" line402="    //--------------------------无线图传----------------------" line403="    //% blockId=setwifiinf" line404="    //% block=&quot;连接wifi名称：%name 密码：%pwd&quot;" line405="    //% group=&quot;无线图传&quot; weight=3" line406="    export function setwifiinf(name: string,pwd:string): void {" line407="        //先切换其他模式" line408="        let buf22 = pins.createBuffer(2);" line409="        buf22[0] = 0" line410="        buf22[1] = 0" line411="        pins.i2cWriteBuffer(ADDRESS, buf22);" line412="        //发送账号密码" line413="        let u_name = encodeToUtf8(name);" line414="        let buf_name = pins.createBuffer(2 + u_name.length);" line415="        buf_name[0] = 165" line416="        buf_name[1] = u_name.length" line417="        for (let m = 0; m &lt; u_name.length; m++) {" line418="            buf_name[m + 2] = u_name[m];" line419="        }" line420="        pins.i2cWriteBuffer(ADDRESS, buf_name);" line421="" line422="        let u_pwd = encodeToUtf8(pwd);" line423="        let buf_pwd = pins.createBuffer(1 + u_pwd.length);" line424="        buf_pwd[0] = 166" line425="        buf_pwd[1] = u_pwd.length" line426="        for (let n = 0; n &lt; u_pwd.length; n++) {" line427="            buf_pwd[n + 2] = u_pwd[n];" line428="        }" line429="        pins.i2cWriteBuffer(ADDRESS, buf_pwd);" line430="" line431="        //停用扫描模式" line432="        let buf32 = pins.createBuffer(2);" line433="        buf32[0] = 165 + 3 " line434="        buf32[1] = 0" line435="        pins.i2cWriteBuffer(ADDRESS, buf32);" line436="" line437="        //切换回图传模式" line438="        buf22[1] = 10" line439="        pins.i2cWriteBuffer(ADDRESS, buf22);" line440="    }" line441="" line442="" line443="    //% blockId=setwifiqr" line444="    //% block=&quot;扫描二维码连接wifi&quot;" line445="    //% group=&quot;无线图传&quot; weight=2" line446="    export function setwifiqr(): void {" line447="        //先切换其他模式" line448="        let buf23 = pins.createBuffer(2);" line449="        buf23[0] = 0" line450="        buf23[1] = 0" line451="        pins.i2cWriteBuffer(ADDRESS, buf23);" line452="        " line453="        //启用用扫描模式" line454="        let buf33 = pins.createBuffer(2);" line455="        buf33[0] = 165 + 3" line456="        buf33[1] = 1" line457="        pins.i2cWriteBuffer(ADDRESS, buf33);" line458="" line459="        //切换回图传模式" line460="        buf23[1] = 10" line461="        pins.i2cWriteBuffer(ADDRESS, buf23);" line462="    }" line463="" line464="" line465="    //--------------------------设置----------------------" line466="    //% blockId=setfilllight" line467="    //% block=&quot;设置补光灯亮度 %light&quot;" line468="    //% light.min=0 light.max=10 light.defl=0  " line469="    //% group=&quot;设置&quot; weight=3" line470="    export function setfilllight(light: number): void {" line471="        light = Math.clamp(0, 10, light)" line472="        let buf24 = pins.createBuffer(2);" line473="        buf24[0] = 180 + 0" line474="        buf24[1] = light" line475="        pins.i2cWriteBuffer(ADDRESS, buf24);" line476="    }" line477="    //% blockId=getfilllight" line478="    //% block=&quot;补光灯亮度&quot;" line479="    //% group=&quot;设置&quot; weight=2" line480="    export function getfilllight(): number {" line481="        sendOrder(180, 0)" line482="        let GetBuff20 = pins.createBuffer(1)" line483="        GetBuff20 = pins.i2cReadBuffer(ADDRESS, 1);" line484="        return GetBuff20.getNumber(NumberFormat.UInt8BE, 0)" line485="    }" line486="}" numlines="487"></mutation></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="function_definition" id=".5V94:`Wpn}-h}4Pt6Z/" x="1071" y="0"><mutation name="encodeToUtf8" functionid="PlNrx5;@)O`!cTe*G{wt"><arg name="str" id="unjsw406cefgw7y3lpyt" type="string"></arg></mutation><field name="function_name">encodeToUtf8</field><value name="unjsw406